# 通用系统文件与本地配置；各客户端继续使用自己的 .gitignore。
.DS_Store
.env
.env.*
!.env.example
*.log
*.tmp
.idea/
.vscode/
.codex-derived/

# 本地生成的依赖、构建产物和测试报告。
node_modules/
build/
dist/
DerivedData/
.gradle/
.kotlin/
.build/
coverage/
venv/
.venv/
__pycache__/

# 签名材料必须保存在仓库之外；忽略规则不能清除历史中的泄漏。
*.jks
*.keystore
*.p12
*.pfx
*.p8
*.key
*.mobileprovision
*.provisionprofile
local.properties
keystore.properties
key.properties
signing.properties
signing.json
signing.env
.secrets/
sparkle_private_key*
sparkle_ed25519_key*
