node_modules/
build/
dist/
DerivedData/
.gradle/
.kotlin/
.build/
coverage/
venv/
.venv/

# 不再添加新的签名材料；已导入的历史文件不受忽略规则影响。
*.jks
*.keystore
*.p12
*.mobileprovision
*.provisionprofile
local.properties
keystore.properties
signing.properties
