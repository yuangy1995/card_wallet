{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "credit-card-ios/shared-json-schema.json",
  "title": "Credit Card Shared JSON Protocol",
  "type": "object",
  "required": ["schemaVersion", "exportedAt", "source", "cards"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.0.0"
    },
    "exportedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
    },
    "source": {
      "type": "string",
      "enum": ["web", "ios", "macos", "android", "windows"]
    },
    "cards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sharedCard"
      }
    },
    "deletedCardIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "sharedCard": {
      "type": "object",
      "required": [
        "id",
        "country",
        "bank",
        "cardNumber",
        "lastModifyTime",
        "isSharedLimit",
        "billingDaySpendingToNextBill"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "country": { "type": "string", "minLength": 1 },
        "bank": { "type": "string", "minLength": 1 },
        "alias": { "type": "string" },
        "level": { "type": "string" },
        "cardNumber": {
          "type": "string",
          "pattern": "^\\d{12,19}$"
        },
        "cvv": {
          "type": "string",
          "pattern": "^\\d{3,4}$"
        },
        "valid": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-2])\\/\\d{2}$"
        },
        "limit": {
          "type": "number",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "enum": ["CNY", "CNH", "USD", "HKD", "MOP", "TWD", "EUR", "GBP", "JPY", "SGD", "AUD", "CAD", "CHF", "THB"]
        },
        "isSharedLimit": { "type": "boolean" },
        "accountBillDate": {
          "type": "string",
          "pattern": "^(?:[1-9]|[12]\\d|3[01])$"
        },
        "dueDate": {
          "type": "string",
          "pattern": "^(?:[1-9]|[12]\\d|3[01])$"
        },
        "billingDaySpendingToNextBill": { "type": "boolean" },
        "annualFee": {
          "type": "number",
          "minimum": 0
        },
        "isQualified": {
          "type": "string",
          "enum": ["1", "2", "3"]
        },
        "nextAnnualFeeCollectionTime": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "lastTime": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "lastModifyTime": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
        },
        "equity": { "type": "string" },
        "remark": { "type": "string" }
      }
    }
  }
}
